{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "ty": {
      "command": [
        "uvx",
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "provider": {},
  "enabled_providers": [
    "google"
  ],
  "autoupdate": true,
  "model": "google/gemini-3.1-pro-preview",
  "default_agent": "plan",
  "small_model": "google/gemini-3-flash-preview",
  "plugin": [
    "opencode-gemini-auth@latest"
  ],
  "watcher": {
    "ignore": [
      ".git/**"
    ]
  },
  "instructions": [
    "GEMINI.md",
    "AGENTS.md",
    "agent_docs/*.md"
  ],
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "grep *": "allow",
      "env": "deny",
      "rg *": "allow"
    },
    "task": "allow",
    "skill": "ask",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
  },
  "mcp": {
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    },
    "mcp-atlassian": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "mcp-atlassian"
      ],
      "environment": {
        "JIRA_URL": "https://ensodata.atlassian.net",
        "JIRA_USERNAME": "{env:ATLASSIAN_USER}",
        "JIRA_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}",
        "CONFLUENCE_URL": "https://ensodata.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "{env:ATLASSIAN_USER}",
        "CONFLUENCE_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}"
      }
    }
  }
}
