{
  "mcpServers": {
    "mcp-atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://ensodata.atlassian.net",
        "JIRA_USERNAME": "${ATLASSIAN_USER}",
        "JIRA_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "CONFLUENCE_URL": "https://ensodata.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "${ATLASSIAN_USER}",
        "CONFLUENCE_API_TOKEN": "${ATLASSIAN_API_TOKEN}"
      }
    }
  }
}
