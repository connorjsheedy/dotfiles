{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "enabled_providers": [
    "google"
  ],
  "autoupdate": true,
  "model": "google/gemini-3.1-pro-preview",
  "default_agent": "plan",
  "small_model": "google/gemini-3-flash-preview",
  "plugin": [
    "opencode-gemini-auth@latest"
  ],
  "theme": "rosepine",
  "watcher": {
    "ignore": [
      ".git/**"
    ]
  },
  "instructions": [
    "GEMINI.md",
    "agent_docs/*.md",
  ],
  "share": "disabled"
}
