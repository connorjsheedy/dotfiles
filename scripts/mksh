#!/usr/bin/env bash


# Get the filename from the first argument, or prompt the user
if [ -n "$1" ]; then
  FILENAME="$1"
else
  read -p "Enter the name of the script: " FILENAME
fi

# Check if a filename was provided
if [ -z "$FILENAME" ]; then
  echo "No filename provided. Exiting."
  exit 1
fi

# Set the full path for the new script
FILEPATH="$HOME/dotfiles/scripts/$FILENAME"

# Create the file and add the shebang
echo "#!/usr/bin/env zsh" > "$FILEPATH"

# Make the script executable
chmod u+x "$FILEPATH"

# Open the file in the default editor
if [ -n "$EDITOR" ]; then
  $EDITOR "$FILEPATH"
else
  echo "EDITOR environment variable not set. Could not open the file."
  echo "File created at: $FILEPATH"
fi
