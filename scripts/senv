# !/bin/bash

target="$WORKENV"
printf "Set environment from:\n"
index=1
choices=()
for f in "$target"/*
do
    fn=$(basename -- "$f") 
    printf "[$index] - $fn\n" 
    choices+=($fn)
    index=$((index + 1))
done
echo 'Choice: '
read choice

top_path=${choices[choice]}

top_level_path="$target/$top_path"
index=1
repo_choices=()
for fl in "$top_level_path"/*
do
    if [ -d $fl ]
    then
        env_dir=$(basename -- "$fl") 
        printf "[$index] - $env_dir\n" 
        repo_choices+=($env_dir)
        index=$((index + 1))
    fi
done

echo "Choice: "
read env_dir
repo_path=${repo_choices[env_dir]}

env_path="$top_level_path/$repo_path/.env"
source $env_path
